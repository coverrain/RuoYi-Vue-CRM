    <update id="updateCustomerManagement" parameterType="CustomerManagement">
        update customer_management
        <trim prefix="SET" suffixOverrides=",">
            <if test="customerName != null and customerName != ''">customer_name = #{customerName},</if>
            <if test="phoneNumber != null">phone_number = #{phoneNumber},</if>
            <if test="wechatId != null">wechat_id = #{wechatId},</if>
            <if test="xiaohongshuId != null">xiaohongshu_id = #{xiaohongshuId},</if>
            <if test="douyinId != null">douyin_id = #{douyinId},</if>
            <if test="type != null">type = #{type},</if>
