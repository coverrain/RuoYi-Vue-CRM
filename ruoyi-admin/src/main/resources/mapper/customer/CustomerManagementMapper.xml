            <if test="salespersonAccountId != null">salesperson_account_id = #{salespersonAccountId},</if>
            <if test="dispatchOrganization != null">dispatch_organization = #{dispatchOrganization},</if>
            <if test="lastDispatchTime != null">last_dispatch_time = #{lastDispatchTime},</if>
            <if test="location != null">location = #{location},</if>
            <if test="consultingProject != null">consulting_project = #{consultingProject},</if>
