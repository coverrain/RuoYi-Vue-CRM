            <if test="promotionAccountId != null">promotion_account_id,</if>
            <if test="customerServiceAccountId != null">customer_service_account_id,</if>
            <if test="salespersonAccountId != null">salesperson_account_id,</if>
            <if test="dispatchOrganization != null">dispatch_organization,</if>
            <if test="lastDispatchTime != null">last_dispatch_time,</if>
            <if test="location != null">location,</if>
            <if test="consultingProject != null">consulting_project,</if>
            <if test="consultingDetails != null">consulting_details,</if>
            <if test="customerIntention != null">customer_intention,</if>
            <if test="recorderAccountId != null">recorder_account_id,</if>
            <if test="recordTime != null">record_time,</if>
            <if test="channelSource != null">channel_source,</if>
            <if test="boostStatus != null">boost_status,</if>
            <if test="serviceStatus != null">service_status,</if>
            <if test="saleStatus != null">sale_status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="customerName != null and customerName != ''">#{customerName},</if>
            <if test="phoneNumber != null">#{phoneNumber},</if>
            <if test="wechatId != null">#{wechatId},</if>
            <if test="xiaohongshuId != null">#{xiaohongshuId},</if>
            <if test="douyinId != null">#{douyinId},</if>
            <if test="type != null">#{type},</if>
            <if test="promotionAccountId != null">#{promotionAccountId},</if>
            <if test="customerServiceAccountId != null">#{customerServiceAccountId},</if>
            <if test="salespersonAccountId != null">#{salespersonAccountId},</if>
            <if test="dispatchOrganization != null">#{dispatchOrganization},</if>
