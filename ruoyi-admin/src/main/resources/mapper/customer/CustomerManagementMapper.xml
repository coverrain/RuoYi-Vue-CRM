        <result property="saleStatus"    column="sale_status"    />
    </resultMap>

    <sql id="selectCustomerManagementVo">
        select customer_id, customer_name, phone_number, wechat_id, xiaohongshu_id, douyin_id, type, promotion_account_id, customer_service_account_id, salesperson_account_id, dispatch_organization, last_dispatch_time, location, consulting_project, consulting_details, customer_intention, recorder_account_id, record_time, channel_source, boost_status, service_status, sale_status from customer_management
    </sql>

    <select id="selectCustomerManagementList" parameterType="CustomerManagement" resultMap="CustomerManagementResult">
        <include refid="selectCustomerManagementVo"/>
        <where>  
            <if test="customerName != null  and customerName != ''"> and customer_name like concat('%', #{customerName}, '%')</if>
            <if test="phoneNumber != null  and phoneNumber != ''"> and phone_number = #{phoneNumber}</if>
            <if test="wechatId != null  and wechatId != ''"> and wechat_id = #{wechatId}</if>
            <if test="xiaohongshuId != null  and xiaohongshuId != ''"> and xiaohongshu_id = #{xiaohongshuId}</if>
            <if test="douyinId != null  and douyinId != ''"> and douyin_id = #{douyinId}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="promotionAccountId != null "> and promotion_account_id = #{promotionAccountId}</if>
            <if test="customerServiceAccountId != null "> and customer_service_account_id = #{customerServiceAccountId}</if>
            <if test="salespersonAccountId != null "> and salesperson_account_id = #{salespersonAccountId}</if>
            <if test="dispatchOrganization != null  and dispatchOrganization != ''"> and dispatch_organization = #{dispatchOrganization}</if>
            <if test="lastDispatchTime != null "> and last_dispatch_time = #{lastDispatchTime}</if>
            <if test="location != null  and location != ''"> and location = #{location}</if>
            <if test="consultingProject != null  and consultingProject != ''"> and consulting_project = #{consultingProject}</if>
            <if test="consultingDetails != null  and consultingDetails != ''"> and consulting_details = #{consultingDetails}</if>
            <if test="customerIntention != null  and customerIntention != ''"> and customer_intention = #{customerIntention}</if>
            <if test="recorderAccountId != null "> and recorder_account_id = #{recorderAccountId}</if>
            <if test="recordTime != null "> and record_time = #{recordTime}</if>
            <if test="channelSource != null  and channelSource != ''"> and channel_source = #{channelSource}</if>
            <if test="boostStatus != null  and boostStatus != ''"> and boost_status = #{boostStatus}</if>
            <if test="serviceStatus != null  and serviceStatus != ''"> and service_status = #{serviceStatus}</if>
            <if test="saleStatus != null  and saleStatus != ''"> and sale_status = #{saleStatus}</if>
        </where>
    </select>
    
    <select id="selectCustomerManagementByCustomerId" parameterType="Long" resultMap="CustomerManagementResult">
        <include refid="selectCustomerManagementVo"/>
        where customer_id = #{customerId}
    </select>

    <insert id="insertCustomerManagement" parameterType="CustomerManagement" useGeneratedKeys="true" keyProperty="customerId">
        insert into customer_management
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="customerName != null and customerName != ''">customer_name,</if>
            <if test="phoneNumber != null">phone_number,</if>
