    <sql id="selectPerformanceStatisticsByPromoterVo">
        select performance_id, promoter_account_id, department_id, lead_quantity, duplicate_order_quantity, duplicate_order_rate, addition_quantity, addition_rate, transaction_quantity, transaction_rate, transaction_amount, rebate_amount, statistical_time_period from performance_statistics_by_promoter
