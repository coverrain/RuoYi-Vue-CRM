    <select id="selectPerformanceStatisticsByPromoterList" parameterType="PerformanceStatisticsByPromoter" resultMap="PerformanceStatisticsByPromoterResult">
        <include refid="selectPerformanceStatisticsByPromoterVo"/>
        <where>  
            <if test="promoterAccountId != null "> and promoter_account_id = #{promoterAccountId}</if>
            <if test="departmentId != null "> and department_id = #{departmentId}</if>
            <if test="leadQuantity != null "> and lead_quantity = #{leadQuantity}</if>
            <if test="duplicateOrderQuantity != null "> and duplicate_order_quantity = #{duplicateOrderQuantity}</if>
            <if test="duplicateOrderRate != null "> and duplicate_order_rate = #{duplicateOrderRate}</if>
            <if test="additionQuantity != null "> and addition_quantity = #{additionQuantity}</if>
            <if test="additionRate != null "> and addition_rate = #{additionRate}</if>
            <if test="transactionQuantity != null "> and transaction_quantity = #{transactionQuantity}</if>
            <if test="transactionRate != null "> and transaction_rate = #{transactionRate}</if>
            <if test="transactionAmount != null "> and transaction_amount = #{transactionAmount}</if>
            <if test="rebateAmount != null "> and rebate_amount = #{rebateAmount}</if>
            <if test="statisticalTimePeriod != null  and statisticalTimePeriod != ''"> and statistical_time_period = #{statisticalTimePeriod}</if>
        </where>
    </select>
    
    <select id="selectPerformanceStatisticsByPromoterByPerformanceId" parameterType="Long" resultMap="PerformanceStatisticsByPromoterResult">
        <include refid="selectPerformanceStatisticsByPromoterVo"/>
